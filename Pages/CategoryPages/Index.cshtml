@page "{id:int?}"
@model Faladau_Andreea_Lab2.Pages.CategoryPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Categories</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Category Name</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.CategoryData.Categories)
        {
            string selectedRow = "";

            if (item.ID == Model.CategoryID)
            {
                selectedRow = "table-success";
            }

            <tr class="@selectedRow">
                <td>
                    @Html.DisplayFor(modelItem => item.CategoryName)
                </td>

                <td>
                    <a asp-page="./Index"
                       asp-route-id="@item.ID">Select</a> |

                    <a asp-page="./Edit"
                       asp-route-id="@item.ID">Edit</a> |

                    <a asp-page="./Details"
                       asp-route-id="@item.ID">Details</a> |

                    <a asp-page="./Delete"
                       asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.CategoryID != 0)
{
    <h3>Books in Selected Category</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Book Title</th>
                <th>Author</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var book in Model.CategoryData.Books)
            {
                <tr>
                    <td>
                        @book.Title
                    </td>

                    <td>
                        @if (book.Authors != null)
                        {
                            @book.Authors.FullName
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
