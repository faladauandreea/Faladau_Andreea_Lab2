
@page
@model Faladau_Andreea_Lab2.Pages.Publishers.IndexModel

@{
    ViewData["Title"] = "Publishers";
}

<h1>Publishers</h1>

<p>
    <a asp-page="./Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Publisher Name</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Publisher)
        {
            <tr>
                <td>@item.PublisherName</td>
                <td>
                    <a asp-page="./Edit"
                       asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details"
                       asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete"
                       asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
