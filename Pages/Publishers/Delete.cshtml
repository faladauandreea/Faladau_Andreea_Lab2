
@page
@model Faladau_Andreea_Lab2.Pages.Publishers.DeleteModel

@{
    ViewData["Title"] = "Delete Publisher";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>Publisher</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            Publisher Name
        </dt>

        <dd class="col-sm-10">
            @Model.Publisher.PublisherName
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Publisher.ID" />

        <input type="submit"
               value="Delete"
               class="btn btn-danger" />

        <a asp-page="./Index">Back to List</a>
    </form>
</div>
